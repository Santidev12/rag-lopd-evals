# Copia este fichero a .env y rellena lo que necesites.
# .env está en .gitignore: nunca se sube al repositorio.

# BGE-M3 vía DeepInfra: se usa tanto para indexar (rag-lopd retrieval indexar, una vez, céntimos)
# como para embeber cada consulta.
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Modelo generador (Gemini, vía rag-lopd generacion ...). Se crea en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcionales: sobrescriben los valores por defecto de src/rag_lopd/config.py
# DATA_DIR=data
# HTTP_TIMEOUT_SECONDS=30

# Azure OpenAI (rag-lopd generacion ... --proveedor azure). No hay clave: se autentica con Entra ID
# (en local, tu sesión de `az login`; desplegado, la identidad gestionada). Hace falta el rol
# "Cognitive Services OpenAI User" sobre el recurso, aunque seas propietario de la suscripción.
# AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<nombre-del-despliegue>
# AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Search (rag-lopd retrieval indexar-azure / evaluar --motor azure-...). Gratis en el nivel Free.
# La clave de administración es un secreto: va solo aquí, nunca en el repositorio. Si se deja vacía, se
# usa Entra ID (rol «Search Index Data Contributor» para indexar, «Search Index Data Reader» para buscar).
# AZURE_SEARCH_ENDPOINT=https://<servicio>.search.windows.net
# AZURE_SEARCH_INDEX=rag-lopd-v0
# AZURE_SEARCH_API_KEY=
