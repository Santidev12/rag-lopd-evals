# Copia este fichero a .env y rellena lo que necesites.
# .env está en .gitignore: nunca se sube al repositorio.

# Embeddings servidos por API (mismo checkpoint BGE-M3 que se usa al indexar en local).
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Modelo generador. Alternativas y sus costes por consulta en docs/research/.
GOOGLE_API_KEY=

# Opcionales: sobrescriben los valores por defecto de src/rag_lopd/config.py
# DATA_DIR=data
# HTTP_TIMEOUT_SECONDS=30
