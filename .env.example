# Copia este fichero a .env y rellena lo que necesites.
# .env está en .gitignore: nunca se sube al repositorio.

# BGE-M3 vía DeepInfra: se usa tanto para indexar (rag-lopd retrieval indexar, una vez, céntimos)
# como para embeber cada consulta.
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Modelo generador (Gemini, vía rag-lopd generacion ...). Se crea en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcionales: sobrescriben los valores por defecto de src/rag_lopd/config.py
# DATA_DIR=data
# HTTP_TIMEOUT_SECONDS=30
